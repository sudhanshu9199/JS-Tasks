/*Understand callback function work*/
```
function stepOne(cb) {
    console.log('step 1');
    cb();
}

function stepTwo(cb) {
    console.log('step 2');
    cb();
}

function stepThree(cb) {
    console.log('step 3');
    cb();
}

stepOne(() => {
    stepTwo(() => {
        stepThree(() => {
            console.log('All callback clearead');
        })
    })
})  // also this is called callback healed or christman tree problem
```

